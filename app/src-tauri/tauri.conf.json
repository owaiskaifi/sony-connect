{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sony Connect",
  "mainBinaryName": "sony-connect",
  "version": "0.1.0",
  "identifier": "dev.owais.sonyconnect",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Sony Connect",
        "width": 400,
        "height": 720,
        "minWidth": 340,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Music",
    "shortDescription": "Control Sony headphones (unofficial, not affiliated with Sony)",
    "longDescription": "Sony Connect lets you view battery and volume and change noise cancelling, ambient sound and ULT modes of Sony Bluetooth headphones from the Linux desktop. Unofficial, not affiliated with Sony.",
    "copyright": "MIT",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "bluez"
        ],
        "section": "sound",
        "desktopTemplate": "sony-connect.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
