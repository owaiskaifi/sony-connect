# Maintainer: owais <tv.sarmadsultan@gmail.com>
#
# Builds Sony Connect (Tauri v2 tray app) and sony-connect-cli from the tagged
# GitHub release tarball.
#
# Regenerating checksums / .SRCINFO (run from this directory, as a normal user):
#   updpkgsums                              # from pacman-contrib; fills sha256sums
#   makepkg --printsrcinfo > .SRCINFO       # required for AUR submission
#   namcap PKGBUILD && namcap sony-connect-*.pkg.tar.zst   # optional lint
#
# Build locally:
#   makepkg -si

pkgname=sony-connect
pkgver=0.1.0
pkgrel=1
pkgdesc="Unofficial Linux control app for Sony headphones (battery, volume, ANC/ambient, ULT mode, tray)"
arch=('x86_64' 'aarch64')
url="https://github.com/owaiskaifi/sony-connect"
license=('MIT')
depends=(
  'webkit2gtk-4.1'
  'gtk3'
  'libayatana-appindicator'   # Tauri v2 tray icon (dlopen'd libayatana-appindicator3.so.1)
  'bluez'
  'bluez-libs'
  'dbus'
  'gcc-libs'
  'glibc'
)
makedepends=(
  'cargo'
  'nodejs'
  'npm'
  'pkgconf'
  'webkit2gtk-4.1'
)
optdepends=('bluez-utils: bluetoothctl for pairing the headset')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # replace with real sum via `updpkgsums` before publishing to the AUR

_srcdir() { echo "$srcdir/$pkgname-$pkgver"; }

prepare() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
  if [[ -f app/src-tauri/Cargo.toml ]] && ! grep -q 'app/src-tauri' Cargo.toml; then
    # app crate is not a workspace member: fetch its own lockfile deps too
    cargo fetch --locked --manifest-path app/src-tauri/Cargo.toml \
      --target "$(rustc -vV | sed -n 's/host: //p')"
  fi
  cd app
  npm ci --no-audit --no-fund
}

build() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"

  # CLI
  cargo build --frozen --release -p sony-core --bin sony-connect-cli

  # GUI (Tauri v2): compile the binary only, no deb/appimage bundling
  cd app
  npm run tauri build -- --no-bundle
}

check() {
  cd "$(_srcdir)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo test --frozen --release -p sony-core
}

package() {
  cd "$(_srcdir)"
  local _target="$srcdir/target/release"

  install -Dm755 "$_target/sony-connect"     "$pkgdir/usr/bin/sony-connect"
  install -Dm755 "$_target/sony-connect-cli" "$pkgdir/usr/bin/sony-connect-cli"

  install -Dm644 packaging/linux/sony-connect.desktop \
    "$pkgdir/usr/share/applications/sony-connect.desktop"

  local _icons=app/src-tauri/icons
  install -Dm644 "$_icons/32x32.png"      "$pkgdir/usr/share/icons/hicolor/32x32/apps/sony-connect.png"
  install -Dm644 "$_icons/128x128.png"    "$pkgdir/usr/share/icons/hicolor/128x128/apps/sony-connect.png"
  install -Dm644 "$_icons/128x128@2x.png" "$pkgdir/usr/share/icons/hicolor/256x256/apps/sony-connect.png"
  install -Dm644 "$_icons/icon.png"       "$pkgdir/usr/share/icons/hicolor/512x512/apps/sony-connect.png"

  install -Dm644 LICENSE   "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
